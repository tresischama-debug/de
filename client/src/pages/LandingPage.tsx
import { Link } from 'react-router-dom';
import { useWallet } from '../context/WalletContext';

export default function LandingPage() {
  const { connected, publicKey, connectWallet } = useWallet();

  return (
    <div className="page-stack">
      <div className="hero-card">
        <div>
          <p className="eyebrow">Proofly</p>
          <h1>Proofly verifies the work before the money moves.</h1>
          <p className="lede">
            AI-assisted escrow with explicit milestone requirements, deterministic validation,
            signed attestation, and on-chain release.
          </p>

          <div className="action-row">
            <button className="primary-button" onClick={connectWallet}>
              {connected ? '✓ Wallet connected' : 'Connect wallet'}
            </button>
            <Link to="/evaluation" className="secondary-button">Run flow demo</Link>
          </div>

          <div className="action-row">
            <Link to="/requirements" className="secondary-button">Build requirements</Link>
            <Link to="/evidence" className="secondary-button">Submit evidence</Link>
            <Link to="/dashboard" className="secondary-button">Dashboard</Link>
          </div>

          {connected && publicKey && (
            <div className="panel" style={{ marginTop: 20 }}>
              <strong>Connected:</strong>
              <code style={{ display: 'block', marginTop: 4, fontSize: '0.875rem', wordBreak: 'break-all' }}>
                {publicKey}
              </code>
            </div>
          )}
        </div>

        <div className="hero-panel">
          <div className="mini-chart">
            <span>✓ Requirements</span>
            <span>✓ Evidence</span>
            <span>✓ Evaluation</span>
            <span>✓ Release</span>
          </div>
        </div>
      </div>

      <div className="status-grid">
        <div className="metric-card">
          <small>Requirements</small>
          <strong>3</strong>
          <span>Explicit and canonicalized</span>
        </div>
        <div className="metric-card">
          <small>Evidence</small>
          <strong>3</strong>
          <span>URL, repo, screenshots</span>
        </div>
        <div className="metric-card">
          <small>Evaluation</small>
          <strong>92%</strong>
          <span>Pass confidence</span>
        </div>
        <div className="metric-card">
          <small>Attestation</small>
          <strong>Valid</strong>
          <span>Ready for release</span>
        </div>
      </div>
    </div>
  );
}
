* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  background: #08101e;
  color: #edf4ff;
  line-height: 1.5;
}

button, input, textarea, select {
  font: inherit;
}

input, textarea, select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(8, 15, 22, 0.75);
  color: #edf4ff;
  padding: 12px 14px;
}

textarea {
  resize: vertical;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
  color: #dbe8ff;
}

label span {
  font-size: 0.9rem;
}

.app-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

.sidebar {
  background: rgba(9, 15, 25, 0.92);
  border-right: 1px solid rgba(148, 163, 184, 0.18);
  padding: 24px 18px;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #60a5fa, #22c55e);
  color: #02110a;
  font-weight: 800;
}

.brand-name {
  font-size: 1.1rem;
  font-weight: 700;
}

.eyebrow {
  margin-bottom: 8px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8eb6ff;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-link {
  display: block;
  padding: 10px 12px;
  border-radius: 10px;
  color: #dfeafc;
  text-decoration: none;
  transition: 0.2s ease;
}

.nav-link.active,
.nav-link:hover {
  background: rgba(59, 130, 246, 0.12);
  color: #fff;
}

.sidebar-card {
  margin-top: 30px;
  padding: 14px 12px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 14px;
}

.main-panel {
  display: flex;
  flex-direction: column;
}

.topbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  background: rgba(7, 12, 20, 0.8);
}

.search-box {
  width: min(440px, 60%);
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  color: #99a9c2;
  background: rgba(15, 23, 42, 0.75);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.8rem;
  background: rgba(34, 197, 94, 0.14);
  color: #8af2b2;
}

.pill.muted {
  background: rgba(148, 163, 184, 0.12);
  color: #dfeafc;
}

.content-area {
  padding: 28px;
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.panel {
  width: 100%;
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 20px;
  padding: 24px;
}

.h1, .panel h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 3vw, 2.8rem);
  line-height: 1.08;
}

.panel h2, .panel h3 {
  margin: 0 0 14px;
}

.lede {
  margin: 0;
  max-width: 760px;
  color: #c9d5eb;
  font-size: 1.08rem;
}

.action-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 20px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 10px 18px;
  border-radius: 12px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  text-decoration: none;
}

.primary-button {
  background: linear-gradient(135deg, #60a5fa, #22c55e);
  color: #03131d;
}

.secondary-button {
  background: rgba(148, 163, 184, 0.08);
  color: #edf4ff;
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.secondary-button.small {
  min-height: 32px;
  padding: 7px 12px;
  font-size: 0.8rem;
}

.primary-button:disabled,
.secondary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.two-col,
.builder-grid,
.status-grid,
.detail-grid,
.grid-two {
  display: grid;
  gap: 18px;
}

.two-col,
.grid-two,
.detail-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.builder-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 12px;
}

.status-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 24px;
}

.metric-card,
.info-card {
  background: rgba(8, 15, 22, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
  padding: 18px;
}

.metric-card small,
.metric-card span,
.muted,
small {
  color: #a9b9d0;
}

.metric-card strong {
  display: block;
  font-size: 1.8rem;
  margin-top: 6px;
  margin-bottom: 4px;
}

.requirement-row {
  background: rgba(8, 15, 22, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
  padding: 18px;
}

.requirement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.checkbox-row {
  display: flex;
  flex-direction: row !important;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.checkbox-row input {
  width: 18px;
  height: 18px;
}

.alert {
  margin-top: 18px;
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 600;
}

.alert.success {
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.2);
  color: #8af2b2;
}

.alert.error {
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #fca5a5;
}

.stepper-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 20px;
}

.stepper-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(8, 15, 22, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.stepper-item.done {
  border-color: rgba(34, 197, 94, 0.32);
}

.stepper-item.pending {
  border-color: rgba(96, 165, 250, 0.32);
}

.stepper-dot {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(96, 165, 250, 0.2);
  color: #dbe8ff;
  font-weight: 700;
}

.stepper-item.done .stepper-dot {
  background: rgba(34, 197, 94, 0.2);
  color: #8af2b2;
}

.stepper-item small {
  display: block;
  margin-top: 4px;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.list-row:last-child {
  border-bottom: 0;
}

.stack {
  display: flex;
  flex-direction: column;
}

.gap-12 {
  gap: 12px;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .status-grid,
  .two-col,
  .builder-grid,
  .grid-two,
  .detail-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .content-area,
  .topbar {
    padding-left: 16px;
    padding-right: 16px;
  }

  .topbar {
    flex-wrap: wrap;
    height: auto;
    padding-top: 14px;
    padding-bottom: 14px;
    gap: 12px;
  }

  .search-box {
    width: 100%;
  }
}


